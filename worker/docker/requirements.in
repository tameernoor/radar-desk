# Worker image dependencies. Compile into requirements.txt (exact versions, sha256 hashes) with
#   uv pip compile worker/docker/requirements.in -o worker/docker/requirements.txt --generate-hashes \
#     --python-version 3.10 --python-platform x86_64-manylinux_2_28
