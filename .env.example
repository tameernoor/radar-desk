# Required
OWNER_TOKEN=change-me-long-random
SESSION_SECRET=change-me-long-random-too

# Where the API is reachable from the browser (used for local storage URLs; the Volume routes are relative)
PUBLIC_BASE_URL=http://127.0.0.1:8000
# Set in production to restrict the Host header
# APP_HOSTNAME=radar-desk.fly.dev

# Local data (SQLite and the local object store)
DATA_DIR=./data

# Object storage. Leave S3_BUCKET unset to use the local adapter.
# STORAGE_BACKEND picks one explicitly: local, s3 or modal_volume (unset means s3 with a bucket, else local).
# STORAGE_BACKEND=modal_volume
# Modal Volume for scans and artefacts with STORAGE_BACKEND=modal_volume; deploy the worker with the same name.
MODAL_DATA_VOLUME=radar-data
# S3_BUCKET=radar-desk
# S3_ENDPOINT_URL=https://fly.storage.tigris.dev
# S3_REGION=auto
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# GPU. fake needs nothing; modal needs the token and the deployed function; worker waits for pull
# workers (python -m radar_worker.pull) holding a token from POST /workers/tokens.
# modal and worker only seed the Compute choice, which the jobs page can change; fake is fixed at start.
GPU_BACKEND=fake
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=
MODAL_APP_NAME=radar-desk
MODAL_FUNCTION_NAME=score
RADAR_GPU=L4,L40S
GPU_TIMEOUT_S=1800
GPU_SCALEDOWN_WINDOW_S=120
GPU_MONTHLY_BUDGET_USD=10
GPU_POLL_INTERVAL_S=10
# Seconds a pull worker's claim lasts without a heartbeat; three expiries fail the job.
WORKER_LEASE_S=120
# The worker image, shown in the owner's docker run line and deployed on RunPod by the app.
# WORKER_IMAGE=ghcr.io/<owner>/radar-worker:latest
# API key from the RunPod console (Settings, API Keys).
# RUNPOD_API_KEY=
# Network volume mounted at /workspace, holding the weights.
# RUNPOD_VOLUME_ID=
# Registry auth id RunPod uses to pull the worker image.
# RUNPOD_REGISTRY_AUTH_ID=
# Data centre of the network volume (default EU-RO-1).
# RUNPOD_DATACENTER=EU-RO-1
# GPU types to try, in order, as RunPod names them; Blackwell parts are refused (the image's torch cannot drive them).
# The budget check reserves one pod at the L4 price whatever the order, so a dearer type first can overshoot it.
# RUNPOD_GPUS=NVIDIA L4,NVIDIA GeForce RTX 4090
# Seconds a pod's worker waits without a job before the pod deletes itself; passed to the pod.
# RADAR_POD_IDLE_DELETE_S=600
# Seconds without an answer from the app before the pod deletes itself; passed to the pod.
# RADAR_POD_APP_LOST_DELETE_S=600
# Hours after which a pod is deleted, busy or not.
# RUNPOD_MAX_POD_HOURS=3
# Seconds a new pod gets to report in before it is deleted.
# RUNPOD_START_TIMEOUT_S=600
# Two apps on one RunPod key delete each other's radar-worker pods; give each app its own key or account.
# The app's public URL for the pod, which the app only checks. Unset, the app runs a quick tunnel.
# WORKER_PUBLIC_URL=https://radar.example.org
# It must be an https URL on port 443; the reachability check speaks TLS on 443 only.
# managed (the app runs cloudflared) or external (WORKER_PUBLIC_URL); unset, it follows WORKER_PUBLIC_URL.
# WORKER_TUNNEL=managed

# Chat. Without CHAT_MODEL (and a key where the provider needs one) the app runs and the chat
# says it is not configured. GET /chat/status shows whether the provider answers.
# LLM_PROVIDER is openrouter (the default), ollama or openai (any OpenAI-compatible endpoint).
# LLM_BASE_URL is optional and overrides the provider's default base URL.
# Without LLM_PROVIDER the provider is inferred from LLM_BASE_URL (openrouter.ai, port 11434 on localhost, else openai).
# LLM_PROVIDER=openrouter
# LLM_BASE_URL=
# LLM_API_KEY=
CHAT_MODEL=
#
# Local Ollama, no key needed (pull the model first with `ollama pull qwen3:8b`).
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# CHAT_MODEL=qwen3:8b
#
# Another OpenAI-compatible endpoint.
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.example.com/v1
# LLM_API_KEY=
# CHAT_MODEL=

# Uploads
MAX_UPLOAD_BYTES=314572800
