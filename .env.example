# Required
OWNER_TOKEN=change-me-long-random
SESSION_SECRET=change-me-long-random-too

# Where the API is reachable from the browser (used for local storage URLs; the Volume routes are relative)
PUBLIC_BASE_URL=http://127.0.0.1:8000
# Set in production to restrict the Host header
# APP_HOSTNAME=radar-desk.fly.dev

# Local data (SQLite and the local object store)
DATA_DIR=./data

# Object storage. Leave S3_BUCKET unset to use the local adapter.
# STORAGE_BACKEND picks one explicitly: local, s3 or modal_volume (unset means s3 with a bucket, else local).
# STORAGE_BACKEND=modal_volume
# Modal Volume for scans and artefacts with STORAGE_BACKEND=modal_volume; deploy the worker with the same name.
MODAL_DATA_VOLUME=radar-data
# S3_BUCKET=radar-desk
# S3_ENDPOINT_URL=https://fly.storage.tigris.dev
# S3_REGION=auto
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# GPU. fake needs nothing; modal needs the token and the deployed function; worker waits for pull
# workers (python -m radar_worker.pull) holding a token from POST /workers/tokens.
GPU_BACKEND=fake
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=
MODAL_APP_NAME=radar-desk
MODAL_FUNCTION_NAME=score
RADAR_GPU=L4,L40S
GPU_TIMEOUT_S=1800
GPU_SCALEDOWN_WINDOW_S=120
GPU_MONTHLY_BUDGET_USD=10
GPU_POLL_INTERVAL_S=10
# Seconds a pull worker's claim lasts without a heartbeat; three expiries fail the job.
WORKER_LEASE_S=120
# Image name shown in the owner's docker run line for a pull worker.
# WORKER_IMAGE=radar-worker

# Chat. Without CHAT_MODEL (and a key where the provider needs one) the app runs and the chat
# says it is not configured. GET /chat/status shows whether the provider answers.
# LLM_PROVIDER is openrouter (the default), ollama or openai (any OpenAI-compatible endpoint).
# LLM_BASE_URL is optional and overrides the provider's default base URL.
# Without LLM_PROVIDER the provider is inferred from LLM_BASE_URL (openrouter.ai, port 11434 on localhost, else openai).
# LLM_PROVIDER=openrouter
# LLM_BASE_URL=
# LLM_API_KEY=
CHAT_MODEL=
#
# Local Ollama, no key needed (pull the model first with `ollama pull qwen3:8b`).
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# CHAT_MODEL=qwen3:8b
#
# Another OpenAI-compatible endpoint.
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.example.com/v1
# LLM_API_KEY=
# CHAT_MODEL=

# Uploads
MAX_UPLOAD_BYTES=314572800
